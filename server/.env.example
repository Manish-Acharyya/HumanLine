# Core
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/hrms
JWT_SECRET=change_me_in_production
JWT_EXPIRES_IN=1d
COOKIE_NAME=hrms_token
CLIENT_URL=http://localhost:5173

# Email for password resets — REQUIRED in production
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="HumanLine <no-reply@example.com>"
TRUST_PROXY=0
AUTH_RATE_LIMIT_MAX=20
